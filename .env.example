# Server-only — never expose as NEXT_PUBLIC_*
MAILER_CONTACT_URL=https://mailer.kickops.dev/kickops/academy/contact

# FE26: full checkout URL, including the provider's pre-applied coupon parameters
NEXT_PUBLIC_CHECKOUT_URL=
# GTM container (GTM-...). GA4 and Clarity are tags inside the container, not env vars.
# Without this ID the app does not inject the GTM script.
NEXT_PUBLIC_GTM_ID=

# Hotmart purchase webhook 2.0 (header X-HOTMART-HOTTOK)
HOTMART_HOTTOK=

# Supabase da Academy — tabela hotmart_purchase_webhooks. Projeto diferente do mailer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Enfileira o e-mail de compra. Sem ela, o webhook responde 500 quando o evento precisa de e-mail.
MAILER_PURCHASE_WEBHOOK_URL=https://mailer.kickops.dev/kickops/academy/purchase-webhook
